<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MusicPlayer.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MusicPlayer.UI.Views"
    Title="Auralis"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <!-- The footer tab bar stays hidden; navigation between the three roots happens through
         the segmented control at the top of each page. The roots still have to exist in the
         Shell hierarchy so absolute routes such as //search and //settings resolve. -->
    <TabBar Shell.TabBarIsVisible="False">
        <ShellContent
            Title="Library"
            Route="library"
            ContentTemplate="{DataTemplate views:LibraryPage}" />
        <ShellContent
            Title="Search"
            Route="search"
            ContentTemplate="{DataTemplate views:SearchPage}" />
        <ShellContent
            Title="Settings"
            Route="settings"
            ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>
</Shell>
