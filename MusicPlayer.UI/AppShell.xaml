<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MusicPlayer.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MusicPlayer.UI.Views"
    Title="Auralis"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <TabBar>
        <ShellContent
            Title="Library"
            Route="library"
            ContentTemplate="{DataTemplate views:LibraryPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe030;"
                    Size="23"
                    Color="{AppThemeBinding Light=#5E5E76, Dark=#9C9CB2}" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="Search"
            Route="search"
            ContentTemplate="{DataTemplate views:SearchPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe8b6;"
                    Size="23"
                    Color="{AppThemeBinding Light=#5E5E76, Dark=#9C9CB2}" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="Settings"
            Route="settings"
            ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe8b8;"
                    Size="23"
                    Color="{AppThemeBinding Light=#5E5E76, Dark=#9C9CB2}" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
