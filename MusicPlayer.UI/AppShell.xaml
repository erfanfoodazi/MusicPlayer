<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MusicPlayer.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MusicPlayer.UI.Views"
    Title="Auralis"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}"
    Shell.TabBarForegroundColor="{DynamicResource AccentColor}"
    Shell.TabBarTitleColor="{DynamicResource AccentColor}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}"
    BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <!-- The three library sections live in a persistent bottom bar; detail screens are
         pushed on top of it and hide it again through Shell.TabBarIsVisible. -->
    <TabBar>
        <ShellContent
            Title="Library"
            Route="library"
            ContentTemplate="{DataTemplate views:LibraryPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe405;"
                    Size="22"
                    Color="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Search"
            Route="search"
            ContentTemplate="{DataTemplate views:SearchPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe8b6;"
                    Size="22"
                    Color="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Settings"
            Route="settings"
            ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe8b8;"
                    Size="22"
                    Color="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
