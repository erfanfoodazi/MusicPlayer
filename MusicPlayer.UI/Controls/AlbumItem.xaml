<?xml version="1.0" encoding="UTF-8" ?>
<Grid
    x:Class="MusicPlayer.UI.Controls.AlbumItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Domain.Models;assembly=Domain"
    xmlns:converters="clr-namespace:MusicPlayer.UI.Converters"
    x:DataType="models:Album"
    RowDefinitions="Auto,Auto,Auto"
    BackgroundColor="Transparent"
    HeightRequest="246">

    <Grid.Resources>
        <converters:ArtworkToImageSourceConverter x:Key="ArtworkToImageSourceConverter" />
        <converters:StringIsNullOrEmptyConverter x:Key="StringIsNullOrEmptyConverter" />
    </Grid.Resources>

    <Grid.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnAlbumTapped" />
    </Grid.GestureRecognizers>

    <!-- Square sleeve: fixed 170x170 cover so GridItemsLayout never re-measures while
         scrolling (this is what caused the "new albums suddenly load" jump). -->
    <Border
        Grid.Row="0"
        HeightRequest="170"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light=#10000000, Dark=#1FFFFFFF}"
        StrokeShape="RoundRectangle 18"
        Background="{StaticResource ArtworkPlaceholderGradient}"
        HorizontalOptions="Fill">
        <Grid>
            <Label
                Text="&#xe019;"
                FontFamily="MaterialIcons"
                FontSize="34"
                TextColor="{DynamicResource AccentColor}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Image
                Source="{Binding CoverArtPath, Converter={StaticResource ArtworkToImageSourceConverter}}"
                Aspect="AspectFill"
                WidthRequest="170"
                HeightRequest="170" />

            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,18,18"
                Background="{StaticResource ArtworkSheen}"
                InputTransparent="True" />

            <Button
                Text="&#xe037;"
                Style="{StaticResource FloatingIconButton}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,8,8"
                Clicked="OnPlayClicked"
                SemanticProperties.Description="Play album" />
        </Grid>
    </Border>

    <!-- Album name and artist under the cover. -->
    <Label
        Grid.Row="1"
        Text="{Binding Title}"
        FontFamily="InterSemiBold"
        FontSize="14"
        CharacterSpacing="-0.15"
        TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
        LineBreakMode="TailTruncation"
        MaxLines="1"
        Margin="2,10,2,0" />

    <Label
        Grid.Row="2"
        Text="{Binding AlbumArtist}"
        FontFamily="Inter"
        FontSize="11.5"
        TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
        LineBreakMode="TailTruncation"
        MaxLines="1"
        Margin="2,2,2,0"
        IsVisible="{Binding AlbumArtist, Converter={StaticResource StringIsNullOrEmptyConverter}, ConverterParameter=inverse}" />
</Grid>
