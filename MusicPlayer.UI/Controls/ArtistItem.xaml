<?xml version="1.0" encoding="UTF-8" ?>
<Grid
    x:Class="MusicPlayer.UI.Controls.ArtistItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Domain.Models;assembly=Domain"
    xmlns:converters="clr-namespace:MusicPlayer.UI.Converters"
    x:DataType="models:Artist"
    ColumnDefinitions="Auto,*,Auto"
    ColumnSpacing="12"
    HeightRequest="60"
    BackgroundColor="Transparent">

    <Grid.Resources>
        <converters:FirstCharConverter x:Key="FirstCharConverter" />
    </Grid.Resources>

    <Grid.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnArtistTapped" />
    </Grid.GestureRecognizers>

    <Border
        Grid.Column="0"
        WidthRequest="44"
        HeightRequest="44"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 22"
        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"
        VerticalOptions="Center">
        <Label
            Text="{Binding Name, Converter={StaticResource FirstCharConverter}}"
            FontFamily="InterBold"
            FontSize="17"
            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Border>

    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
        <Label
            Text="{Binding Name}"
            FontFamily="InterSemiBold"
            FontSize="15"
            CharacterSpacing="-0.1"
            TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
            LineBreakMode="TailTruncation" />
        <Label
            Text="{Binding TrackCount, StringFormat='{0} tracks'}"
            FontFamily="Inter"
            FontSize="12"
            TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
            LineBreakMode="TailTruncation" />
    </VerticalStackLayout>

    <Label
        Grid.Column="2"
        Text="&#xe5cc;"
        FontFamily="MaterialIcons"
        FontSize="20"
        TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}"
        VerticalOptions="Center"
        Margin="0,0,8,0" />
</Grid>
