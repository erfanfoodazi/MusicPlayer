<?xml version="1.0" encoding="UTF-8" ?>
<Grid
    x:Class="MusicPlayer.UI.Controls.PlaylistItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Domain.Models;assembly=Domain"
    xmlns:converters="clr-namespace:MusicPlayer.UI.Converters"
    x:DataType="models:Playlist"
    RowDefinitions="Auto,Auto,Auto"
    HeightRequest="238"
    BackgroundColor="Transparent">

    <Grid.Resources>
        <converters:ArtworkToImageSourceConverter x:Key="ArtworkToImageSourceConverter" />
        <converters:StringIsNullOrEmptyConverter x:Key="StringIsNullOrEmptyConverter" />
    </Grid.Resources>

    <Grid.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnPlaylistTapped" />
    </Grid.GestureRecognizers>

    <!-- Square sleeve, matching the Albums grid so the two tabs feel like one library. -->
    <Border
        Grid.Row="0"
        HeightRequest="170"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light=#10000000, Dark=#1FFFFFFF}"
        StrokeShape="RoundRectangle 18"
        Background="{StaticResource ArtworkPlaceholderGradient}"
        HorizontalOptions="Fill">
        <Grid>
            <Label
                Text="&#xe03d;"
                FontFamily="MaterialIcons"
                FontSize="34"
                TextColor="{DynamicResource AccentColor}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Image
                Source="{Binding ArtworkPath, Converter={StaticResource ArtworkToImageSourceConverter}}"
                Aspect="AspectFill"
                WidthRequest="170"
                HeightRequest="170"
                IsVisible="{Binding ArtworkPath, Converter={StaticResource StringIsNullOrEmptyConverter}, ConverterParameter=inverse}" />

            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,18,18"
                Background="{StaticResource ArtworkSheen}"
                InputTransparent="True" />

            <Button
                Text="&#xe5d4;"
                Style="{StaticResource FloatingIconButton}"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,8,8,0"
                Clicked="OnMenuClicked"
                SemanticProperties.Description="Playlist options" />

            <Button
                Text="&#xe037;"
                Style="{StaticResource FloatingIconButton}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,8,8"
                Clicked="OnPlayClicked"
                SemanticProperties.Description="Play playlist" />
        </Grid>
    </Border>

    <Label
        Grid.Row="1"
        Text="{Binding Name}"
        FontFamily="InterSemiBold"
        FontSize="14"
        CharacterSpacing="-0.15"
        TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
        LineBreakMode="TailTruncation"
        MaxLines="1"
        Margin="2,10,2,0" />

    <Label
        Grid.Row="2"
        Text="{Binding TrackCountText}"
        FontFamily="Inter"
        FontSize="11.5"
        TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
        LineBreakMode="TailTruncation"
        Margin="2,2,2,0" />
</Grid>
