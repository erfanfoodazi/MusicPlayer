<?xml version="1.0" encoding="UTF-8" ?>
<Grid
    x:Class="MusicPlayer.UI.Controls.TrackItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Domain.Models;assembly=Domain"
    xmlns:converters="clr-namespace:MusicPlayer.UI.Converters"
    x:DataType="models:Music"
    ColumnDefinitions="Auto,*,Auto,Auto"
    HeightRequest="68"
    ColumnSpacing="14"
    BackgroundColor="Transparent">

    <Grid.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        <converters:StringIsNullOrEmptyConverter x:Key="StringIsNullOrEmptyConverter" />
        <converters:ArtworkToImageSourceConverter x:Key="ArtworkToImageSourceConverter" />
    </Grid.Resources>

    <Grid.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnTrackTapped" />
    </Grid.GestureRecognizers>

    <!-- Soft accent highlight behind the row that is currently playing. -->
    <Border
        x:Name="RowHighlight"
        Grid.ColumnSpan="4"
        Margin="-8,-3"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 15"
        IsVisible="False"
        InputTransparent="True" />

    <Border
        x:Name="CoverArt"
        Grid.Column="0"
        WidthRequest="52"
        HeightRequest="52"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 15"
        Background="{StaticResource ArtworkPlaceholderGradient}"
        VerticalOptions="Center">
        <Grid>
            <Label
                Text="&#xe405;"
                FontFamily="MaterialIcons"
                FontSize="20"
                TextColor="{DynamicResource AccentColor}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            <Image
                Source="{Binding ListArtworkPath, Converter={StaticResource ArtworkToImageSourceConverter}}"
                Aspect="AspectFill"
                IsVisible="{Binding ListArtworkPath, Converter={StaticResource StringIsNullOrEmptyConverter}, ConverterParameter=inverse}" />
        </Grid>
    </Border>

    <!-- Album pages list position instead of repeating the same cover on every row. -->
    <Label
        x:Name="TrackNumberLabel"
        Grid.Column="0"
        WidthRequest="26"
        IsVisible="False"
        FontFamily="InterMedium"
        FontSize="13"
        HorizontalTextAlignment="Center"
        VerticalTextAlignment="Center"
        TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />

    <Grid Grid.Column="1" VerticalOptions="Center" RowDefinitions="Auto,Auto" RowSpacing="1">
        <Label
            x:Name="TitleLabel"
            Grid.Row="0"
            Text="{Binding Name}"
            FontFamily="InterSemiBold"
            FontSize="15"
            CharacterSpacing="-0.1"
            TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
            LineBreakMode="TailTruncation" />

        <Label
            x:Name="ArtistLabel"
            Grid.Row="1"
            Text="{Binding ArtistName}"
            FontFamily="Inter"
            FontSize="12"
            TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
            LineBreakMode="TailTruncation" />
    </Grid>

    <HorizontalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
        <Label
            x:Name="PlayingIcon"
            Text="&#xe1b8;"
            FontFamily="MaterialIcons"
            FontSize="15"
            TextColor="{DynamicResource AccentColor}"
            IsVisible="False"
            VerticalOptions="Center" />
        <Label
            Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}"
            FontFamily="Inter"
            FontSize="12"
            TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}"
            VerticalOptions="Center" />
    </HorizontalStackLayout>

    <Button
        Grid.Column="3"
        Text="&#xe5d4;"
        FontFamily="MaterialIcons"
        FontSize="20"
        TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
        BackgroundColor="Transparent"
        WidthRequest="36"
        HeightRequest="44"
        MinimumWidthRequest="36"
        MinimumHeightRequest="44"
        CornerRadius="18"
        Padding="0"
        Clicked="OnMenuClicked"
        SemanticProperties.Description="Track options" />
</Grid>
