<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MusicPlayer.UI.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MusicPlayer.UI.ViewModels"
    xmlns:converters="clr-namespace:MusicPlayer.UI.Converters"
    xmlns:controls="clr-namespace:MusicPlayer.UI.Controls"
    x:DataType="viewmodels:NowPlayingViewModel"
    Title="Now Playing"
    Shell.PresentationMode="ModalAnimated"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ContentPage.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        <converters:ArtworkToImageSourceConverter x:Key="ArtworkToImageSourceConverter" />

        <!-- These keys shadow the app palette for this page only. The code-behind replaces
             them with the current cover's colours, so every control below follows the sleeve. -->
        <Color x:Key="AccentColor">#B7A7FF</Color>
        <Color x:Key="AccentSoftColor">#1A1533</Color>
        <Color x:Key="AccentMutedColor">#8E82C8</Color>
        <Color x:Key="AccentBorderColor">#4DB7A7FF</Color>
        <Color x:Key="PanelColor">#121019</Color>
        <Color x:Key="PlayButtonColor">#CDE7E2</Color>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B7A7FF" Offset="0.0" />
            <GradientStop Color="#7C5CFF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

        <!-- Backdrop tinted with the cover's own colour; the brush is built in code so it can
             follow every track without re-templating the page. -->
        <Grid
            x:Name="AmbientBackdrop"
            Grid.RowSpan="5"
            Opacity="0"
            InputTransparent="True" />

        <!-- ===== Header: close, output device, queue, more ===== -->
        <Grid x:Name="PageHeader" Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Padding="8,4,8,0" ColumnSpacing="2">
            <Button
                Grid.Column="0"
                Text="&#xe5c4;"
                Style="{StaticResource IconButton}"
                FontSize="23"
                Clicked="OnCloseClicked"
                SemanticProperties.Description="Close now playing" />

            <!-- Mirrors the system audio route; the label is filled in when the page appears. -->
            <Border
                Grid.Column="1"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="13,7"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                StrokeShape="RoundRectangle 19"
                Background="{AppThemeBinding Light={StaticResource GlassFillLight}, Dark={StaticResource GlassFillDark}}">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label
                        Text="&#xe32d;"
                        FontFamily="MaterialIcons"
                        FontSize="15"
                        TextColor="{DynamicResource AccentColor}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="OutputLabel"
                        Text="Phone speaker"
                        FontFamily="InterSemiBold"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
                        VerticalOptions="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />
                </HorizontalStackLayout>
            </Border>

            <Button
                Grid.Column="2"
                Text="&#xe03d;"
                Style="{StaticResource IconButton}"
                FontSize="22"
                Clicked="OnQueueClicked"
                SemanticProperties.Description="Show queue" />

            <Button
                Grid.Column="3"
                Text="&#xe5d4;"
                Style="{StaticResource IconButton}"
                FontSize="22"
                Clicked="OnAudioToolsClicked"
                SemanticProperties.Description="Audio tools" />
        </Grid>

        <!-- ===== Artwork, title, meta and seek ===== -->
        <VerticalStackLayout
            x:Name="ContentStack"
            Grid.Row="1"
            Padding="24,4,24,0"
            Spacing="0"
            VerticalOptions="Center">

            <Border
                x:Name="ArtworkCard"
                WidthRequest="320"
                HeightRequest="320"
                HorizontalOptions="Center"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#14000000, Dark=#1AFFFFFF}"
                StrokeShape="RoundRectangle 24"
                Background="{StaticResource ArtworkPlaceholderGradient}">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,18" Radius="34" Opacity="0.42" />
                </Border.Shadow>
                <Grid>
                    <Label
                        Text="&#xe405;"
                        FontFamily="MaterialIcons"
                        FontSize="56"
                        TextColor="{DynamicResource AccentColor}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                    <Image
                        x:Name="CoverImage"
                        Source="{Binding ArtworkSource}"
                        Aspect="AspectFill"
                        WidthRequest="320"
                        HeightRequest="320" />
                </Grid>
            </Border>

            <controls:MarqueeLabel
                x:Name="TrackTitleMarquee"
                Text="{Binding CurrentTrackDisplayName}"
                FontFamily="InterBold"
                FontSize="30"
                CharacterSpacing="-0.8"
                TextAlignment="Start"
                TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
                Margin="2,22,2,0" />

            <Label
                Text="{Binding CurrentMetaLine}"
                FontFamily="InterSemiBold"
                FontSize="10.5"
                CharacterSpacing="1.3"
                TextTransform="Uppercase"
                TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                Margin="2,7,2,0" />

            <Label
                Text="{Binding PlaybackError}"
                FontFamily="Inter"
                FontSize="12"
                TextColor="{StaticResource Danger}"
                HorizontalTextAlignment="Start"
                Margin="2,8,2,0"
                IsVisible="{Binding HasPlaybackError}"
                LineBreakMode="WordWrap" />

            <!-- Seek -->
            <Slider
                x:Name="SeekSlider"
                Minimum="0"
                Maximum="{Binding SliderMaximum}"
                Value="{Binding Position}"
                DragCompleted="OnSeekCompleted"
                IsEnabled="{Binding HasCurrentTrack}"
                Margin="0,16,-2,-8"
                MinimumTrackColor="{DynamicResource AccentColor}"
                MaximumTrackColor="{AppThemeBinding Light=#24000000, Dark=#24FFFFFF}"
                ThumbColor="{DynamicResource AccentColor}" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,0">
                <Label
                    Grid.Column="0"
                    Text="{Binding Position, Converter={StaticResource TimeSpanToStringConverter}}"
                    FontFamily="InterSemiBold"
                    FontSize="10.5"
                    TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />
                <Label
                    Grid.Column="2"
                    Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}"
                    FontFamily="InterSemiBold"
                    FontSize="10.5"
                    TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />
            </Grid>
        </VerticalStackLayout>

        <!-- ===== Transport: three oversized tiles, play in the cover's pastel tone ===== -->
        <Grid
            x:Name="TransportRow"
            Grid.Row="2"
            ColumnDefinitions="*,1.14*,*"
            ColumnSpacing="10"
            Padding="20,10,20,0">

            <Button
                Grid.Column="0"
                Text="&#xe045;"
                FontFamily="MaterialIcons"
                FontSize="27"
                HeightRequest="76"
                Padding="0"
                CornerRadius="24"
                BackgroundColor="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}"
                TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
                Command="{Binding PlayPreviousCommand}"
                IsEnabled="{Binding HasCurrentTrack}"
                SemanticProperties.Description="Previous track" />

            <Button
                x:Name="PlayPauseButton"
                Grid.Column="1"
                Text="{Binding PlayPauseIcon}"
                FontFamily="MaterialIcons"
                FontSize="31"
                HeightRequest="76"
                Padding="0"
                CornerRadius="24"
                BackgroundColor="{DynamicResource PlayButtonColor}"
                TextColor="#0D1215"
                Command="{Binding TogglePlayPauseCommand}"
                IsEnabled="{Binding HasCurrentTrack}"
                SemanticProperties.Description="Play or pause" />

            <Button
                Grid.Column="2"
                Text="&#xe044;"
                FontFamily="MaterialIcons"
                FontSize="27"
                HeightRequest="76"
                Padding="0"
                CornerRadius="24"
                BackgroundColor="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}"
                TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
                Command="{Binding PlayNextCommand}"
                IsEnabled="{Binding HasCurrentTrack}"
                SemanticProperties.Description="Next track" />
        </Grid>

        <!-- ===== Volume + shuffle / repeat / tools ===== -->
        <Grid Grid.Row="3" ColumnDefinitions="*,48,48,48" ColumnSpacing="8" Margin="20,10,20,0">

            <Border
                Grid.Column="0"
                HeightRequest="48"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                StrokeShape="RoundRectangle 16"
                Background="{AppThemeBinding Light={StaticResource GlassFillLight}, Dark={StaticResource GlassFillDark}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2" Padding="6,0">
                    <Button
                        Grid.Column="0"
                        Text="{Binding MuteGlyph}"
                        FontFamily="MaterialIcons"
                        FontSize="18"
                        WidthRequest="34"
                        HeightRequest="34"
                        MinimumWidthRequest="34"
                        MinimumHeightRequest="34"
                        Padding="0"
                        CornerRadius="17"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
                        Command="{Binding ToggleMuteCommand}"
                        SemanticProperties.Description="Mute" />
                    <Slider
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding Volume, Mode=TwoWay}"
                        HeightRequest="30"
                        VerticalOptions="Center"
                        MinimumTrackColor="{DynamicResource AccentColor}"
                        MaximumTrackColor="{AppThemeBinding Light=#24000000, Dark=#24FFFFFF}"
                        ThumbColor="{DynamicResource AccentColor}"
                        SemanticProperties.Description="Volume" />
                </Grid>
            </Border>

            <Button
                Grid.Column="1"
                Text="&#xe043;"
                FontFamily="MaterialIcons"
                FontSize="20"
                HeightRequest="48"
                Padding="0"
                CornerRadius="16"
                BorderWidth="1"
                BorderColor="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                BackgroundColor="{AppThemeBinding Light=#14000000, Dark=#1FFFFFFF}"
                TextColor="{DynamicResource AccentMutedColor}"
                Command="{Binding ToggleShuffleCommand}"
                SemanticProperties.Description="Shuffle">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsShuffle}" Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button
                Grid.Column="2"
                Text="{Binding RepeatIcon}"
                FontFamily="MaterialIcons"
                FontSize="20"
                HeightRequest="48"
                Padding="0"
                CornerRadius="16"
                BorderWidth="1"
                BorderColor="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                BackgroundColor="{AppThemeBinding Light=#14000000, Dark=#1FFFFFFF}"
                TextColor="{DynamicResource AccentMutedColor}"
                Command="{Binding CycleRepeatModeCommand}"
                SemanticProperties.Description="Repeat mode">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsRepeatActive}" Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button
                Grid.Column="3"
                Text="&#xe429;"
                FontFamily="MaterialIcons"
                FontSize="20"
                HeightRequest="48"
                Padding="0"
                CornerRadius="16"
                BorderWidth="1"
                BorderColor="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                BackgroundColor="{AppThemeBinding Light=#14000000, Dark=#1FFFFFFF}"
                TextColor="{DynamicResource AccentMutedColor}"
                Clicked="OnAudioToolsClicked"
                SemanticProperties.Description="Audio tools" />
        </Grid>

        <!-- ===== Bottom actions ===== -->
        <HorizontalStackLayout Grid.Row="4" Spacing="8" HorizontalOptions="Center" Margin="20,10,20,12">

            <Border
                HeightRequest="42"
                Padding="14,0"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                StrokeShape="RoundRectangle 21"
                Background="{AppThemeBinding Light={StaticResource GlassFillLight}, Dark={StaticResource GlassFillDark}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQueueTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                    <Label
                        Text="&#xe03d;"
                        FontFamily="MaterialIcons"
                        FontSize="17"
                        TextColor="{DynamicResource AccentColor}"
                        VerticalOptions="Center" />
                    <Label
                        Text="Playing queue"
                        FontFamily="InterSemiBold"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border
                HeightRequest="42"
                Padding="14,0"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                StrokeShape="RoundRectangle 21"
                Background="{AppThemeBinding Light={StaticResource GlassFillLight}, Dark={StaticResource GlassFillDark}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLyricsTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                    <Label
                        Text="&#xec0b;"
                        FontFamily="MaterialIcons"
                        FontSize="17"
                        TextColor="{DynamicResource AccentColor}"
                        VerticalOptions="Center" />
                    <Label
                        Text="Lyrics"
                        FontFamily="InterSemiBold"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border
                HeightRequest="42"
                Padding="14,0"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                StrokeShape="RoundRectangle 21"
                Background="{AppThemeBinding Light={StaticResource GlassFillLight}, Dark={StaticResource GlassFillDark}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSleepTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                    <Label
                        Text="&#xe8b2;"
                        FontFamily="MaterialIcons"
                        FontSize="17"
                        TextColor="{DynamicResource AccentColor}"
                        VerticalOptions="Center" />
                    <Label
                        Text="Sleep timer"
                        FontFamily="InterSemiBold"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </HorizontalStackLayout>

        <!-- ===== Queue sheet ===== -->
        <Grid x:Name="QueueOverlay" Grid.RowSpan="5" IsVisible="False">
            <BoxView x:Name="QueueScrim" Color="#99000000" Opacity="0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQueueScrimTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                x:Name="QueueSheet"
                VerticalOptions="End"
                MaximumHeightRequest="580"
                Padding="18,10,18,16"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                StrokeShape="RoundRectangle 24,24,0,0"
                Background="{AppThemeBinding Light=#FAFFFFFF, Dark=#FA0B0B12}">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,-8" Radius="24" Opacity="0.35" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
                    <Border Grid.Row="0" Style="{StaticResource SheetGrabber}" />

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="Queue" Style="{StaticResource SheetTitleText}" />
                            <Label Text="{Binding QueueCountText}" Style="{StaticResource CaptionText}" FontSize="11" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Clear"
                            FontFamily="InterSemiBold"
                            FontSize="12"
                            HeightRequest="34"
                            MinimumHeightRequest="34"
                            Padding="14,0"
                            CornerRadius="17"
                            BackgroundColor="{AppThemeBinding Light=#14000000, Dark=#1FFFFFFF}"
                            TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
                            VerticalOptions="Center"
                            Clicked="OnClearQueueClicked" />

                        <Button
                            Grid.Column="2"
                            Text="&#xe5cd;"
                            Style="{StaticResource IconButton}"
                            FontSize="20"
                            VerticalOptions="Center"
                            Clicked="OnQueueClicked"
                            SemanticProperties.Description="Close queue" />
                    </Grid>

                    <BoxView Grid.Row="2" Style="{StaticResource DividerLine}" />

                    <!-- What is playing right now, always visible above the queue. -->
                    <Border
                        Grid.Row="3"
                        Padding="10,9"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource AccentSoftColor}"
                        IsVisible="{Binding HasCurrentTrack}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 11"
                                Background="{StaticResource ArtworkPlaceholderGradient}">
                                <Image
                                    Source="{Binding ArtworkSource}"
                                    Aspect="AspectFill"
                                    WidthRequest="44"
                                    HeightRequest="44" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                <Label
                                    Text="NOW PLAYING"
                                    FontFamily="InterSemiBold"
                                    FontSize="9"
                                    CharacterSpacing="1.6"
                                    TextColor="{DynamicResource AccentColor}" />
                                <Label
                                    Text="{Binding CurrentTrackDisplayName}"
                                    FontFamily="InterSemiBold"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation"
                                    TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}" />
                                <Label
                                    Text="{Binding CurrentTrackArtist}"
                                    FontFamily="Inter"
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="&#xe1b8;"
                                FontFamily="MaterialIcons"
                                FontSize="22"
                                VerticalOptions="Center"
                                TextColor="{DynamicResource AccentColor}" />
                        </Grid>
                    </Border>

                    <CollectionView
                        Grid.Row="4"
                        x:Name="QueueList"
                        ItemsSource="{Binding QueueSections}"
                        IsGrouped="True"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never"
                        ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,36" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="&#xe03d;" FontFamily="MaterialIcons" FontSize="30" TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" HorizontalOptions="Center" />
                                <Label Text="Nothing else in this session yet" Style="{StaticResource CaptionText}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <!-- Group title: previously played vs. upcoming. -->
                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate x:DataType="viewmodels:QueueSection">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="2,14,2,5">
                                    <Label
                                        Text="{Binding Title}"
                                        Style="{StaticResource GroupHeaderText}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding CountLabel}"
                                        Style="{StaticResource MetaText}"
                                        FontSize="10"
                                        VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:QueueRow">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" HeightRequest="64" Padding="2,0">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnQueueRowTapped" />
                                    </Grid.GestureRecognizers>

                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Background="{StaticResource ArtworkPlaceholderGradient}"
                                        VerticalOptions="Center">
                                        <Grid>
                                            <Label Text="&#xe405;" FontFamily="MaterialIcons" FontSize="17" TextColor="{DynamicResource AccentColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Image
                                                Source="{Binding Track.ListArtworkPath, Converter={StaticResource ArtworkToImageSourceConverter}}"
                                                Aspect="AspectFill" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                        <Label
                                            Text="{Binding Track.Name}"
                                            FontFamily="InterSemiBold"
                                            FontSize="13"
                                            TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding Track.ArtistName}"
                                            FontFamily="Inter"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Played rows get a check mark; upcoming rows show the runtime. -->
                                    <Label
                                        Grid.Column="2"
                                        Text="&#xe5ca;"
                                        FontFamily="MaterialIcons"
                                        FontSize="15"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding IsPlayed}"
                                        TextColor="{DynamicResource AccentColor}" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding Track.Duration, Converter={StaticResource TimeSpanToStringConverter}}"
                                        FontFamily="Inter"
                                        FontSize="11"
                                        TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding IsUpNext}" />

                                    <Button
                                        Grid.Column="3"
                                        Text="&#xe5cd;"
                                        FontFamily="MaterialIcons"
                                        FontSize="18"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        MinimumWidthRequest="34"
                                        MinimumHeightRequest="34"
                                        Padding="0"
                                        CornerRadius="17"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}"
                                        CommandParameter="{Binding Track}"
                                        Clicked="OnRemoveQueueItemClicked"
                                        SemanticProperties.Description="Remove from queue" />

                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsPlayed}" Value="True">
                                            <Setter Property="Opacity" Value="0.62" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
