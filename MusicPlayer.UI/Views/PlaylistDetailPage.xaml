<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MusicPlayer.UI.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MusicPlayer.UI.ViewModels"
    xmlns:controls="clr-namespace:MusicPlayer.UI.Controls"
    xmlns:models="clr-namespace:Domain.Models;assembly=Domain"
    xmlns:converters="clr-namespace:MusicPlayer.UI.Converters"
    x:DataType="viewmodels:PlaylistDetailViewModel"
    Title="Playlist"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ContentPage.Resources>
        <converters:ArtworkToImageSourceConverter x:Key="ArtworkToImageSourceConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <BoxView
            Grid.RowSpan="2"
            HeightRequest="300"
            VerticalOptions="Start"
            InputTransparent="True"
            Background="{DynamicResource HeaderWash}" />

        <!-- ===== Top bar ===== -->
        <Grid x:Name="TopBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Padding="8,6,8,0">
            <Button
                Grid.Column="0"
                Text="&#xe5c4;"
                Style="{StaticResource IconButton}"
                FontSize="23"
                Clicked="OnBackClicked"
                SemanticProperties.Description="Back" />
            <Label
                Grid.Column="1"
                Text="PLAYLIST"
                Style="{StaticResource OverlineText}"
                CharacterSpacing="2"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />
            <Button
                Grid.Column="2"
                Text="&#xe145;"
                Style="{StaticResource IconButton}"
                FontSize="22"
                Command="{Binding AddSongsCommand}"
                SemanticProperties.Description="Add songs to this playlist" />
            <Button
                Grid.Column="3"
                Text="&#xe5d4;"
                Style="{StaticResource IconButton}"
                FontSize="22"
                Clicked="OnPlaylistMenuClicked"
                SemanticProperties.Description="Playlist options" />
        </Grid>

        <!-- ===== Cover + tracks ===== -->
        <CollectionView
            x:Name="PlaylistContent"
            Grid.Row="1"
            ItemsSource="{Binding Tracks}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.Header>
                <VerticalStackLayout x:DataType="viewmodels:PlaylistDetailViewModel" Spacing="0" Padding="20,8,20,10">

                    <Border
                        WidthRequest="204"
                        HeightRequest="204"
                        HorizontalOptions="Center"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Background="{StaticResource ArtworkPlaceholderGradient}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCoverTapped" />
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,10" Radius="24" Opacity="0.3" />
                        </Border.Shadow>
                        <Grid>
                            <Label
                                Text="&#xe03d;"
                                FontFamily="MaterialIcons"
                                FontSize="56"
                                TextColor="{DynamicResource AccentColor}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            <Image
                                Source="{Binding Playlist.ArtworkPath, Converter={StaticResource ArtworkToImageSourceConverter}}"
                                Aspect="AspectFill"
                                WidthRequest="204"
                                HeightRequest="204"
                                IsVisible="{Binding Playlist.ArtworkPath, Converter={StaticResource StringNotEmptyConverter}}" />

                            <!-- Replace the sleeve with any picture from the device. -->
                            <Button
                                Text="&#xe412;"
                                FontFamily="MaterialIcons"
                                FontSize="18"
                                WidthRequest="40"
                                HeightRequest="40"
                                MinimumWidthRequest="40"
                                MinimumHeightRequest="40"
                                Padding="0"
                                CornerRadius="20"
                                BackgroundColor="#99000000"
                                TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                Margin="10"
                                Clicked="OnChangeCoverClicked"
                                SemanticProperties.Description="Change playlist cover" />
                        </Grid>
                    </Border>

                    <Label
                        Text="{Binding Playlist.Name}"
                        FontFamily="InterBold"
                        FontSize="23"
                        CharacterSpacing="-0.4"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        Margin="0,20,0,0"
                        TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}" />

                    <Label
                        Text="{Binding Playlist.TrackCount, StringFormat='{0} tracks'}"
                        Style="{StaticResource CaptionText}"
                        HorizontalTextAlignment="Center"
                        Margin="0,4,0,0" />

                    <!-- Actions -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,18,0,4">
                        <Border
                            HeightRequest="44"
                            Padding="22,0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{DynamicResource Primary}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayPlaylistCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                <Label Text="&#xe037;" FontFamily="MaterialIcons" FontSize="19" TextColor="White" VerticalOptions="Center" />
                                <Label Text="Play" FontFamily="InterSemiBold" FontSize="14" TextColor="White" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border
                            HeightRequest="44"
                            Padding="18,0"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                            StrokeShape="RoundRectangle 22"
                            Background="{AppThemeBinding Light={StaticResource GlassFillLight}, Dark={StaticResource GlassFillDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShufflePlayCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                <Label
                                    Text="&#xe043;"
                                    FontFamily="MaterialIcons"
                                    FontSize="19"
                                    VerticalOptions="Center"
                                    TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}" />
                                <Label
                                    Text="Shuffle"
                                    FontFamily="InterSemiBold"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    TextColor="{AppThemeBinding Light={StaticResource TextOnLight}, Dark={StaticResource TextOnDark}}" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border
                            HeightRequest="44"
                            Padding="18,0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{DynamicResource AccentSoftColor}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddSongsCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                <Label
                                    Text="&#xe145;"
                                    FontFamily="MaterialIcons"
                                    FontSize="19"
                                    VerticalOptions="Center"
                                    TextColor="{DynamicResource AccentColor}" />
                                <Label
                                    Text="Add"
                                    FontFamily="InterSemiBold"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    TextColor="{DynamicResource AccentColor}" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" Margin="2,18,2,4">
                        <Label Text="TRACKS" Style="{StaticResource SectionLabelText}" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="Hold and drag to reorder"
                            Style="{StaticResource CaptionText}"
                            FontSize="10"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,24" Spacing="10">
                    <Label Text="This playlist is empty" Style="{StaticResource SectionTitleText}" HorizontalTextAlignment="Center" />
                    <Label Text="Pick a batch of songs from your library to get it started." Style="{StaticResource CaptionText}" HorizontalTextAlignment="Center" />
                    <Button
                        Text="Add songs"
                        Style="{StaticResource PrimaryPillButton}"
                        HorizontalOptions="Center"
                        Margin="0,4,0,0"
                        Command="{Binding AddSongsCommand}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="12" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Music">
                    <Grid Margin="14,0">
                        <controls:TrackItem
                            Track="{Binding .}"
                            IsReorderable="True"
                            RowDragStarting="OnTrackDragStarting"
                            RowDragCompleted="OnTrackDragCompleted"
                            RowDrop="OnTrackDrop" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Docked mini player -->
        <controls:MiniPlayer Grid.Row="2" />
    </Grid>
</ContentPage>
