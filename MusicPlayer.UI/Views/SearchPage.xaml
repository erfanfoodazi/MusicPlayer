<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MusicPlayer.UI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MusicPlayer.UI.ViewModels"
    xmlns:controls="clr-namespace:MusicPlayer.UI.Controls"
    xmlns:models="clr-namespace:Domain.Models;assembly=Domain"
    xmlns:converters="clr-namespace:MusicPlayer.UI.Converters"
    x:DataType="viewmodels:SearchViewModel"
    Title="Search"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ContentPage.Resources>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" RowDefinitions="Auto,*">

            <BoxView
                Grid.Row="0"
                HeightRequest="150"
                VerticalOptions="Start"
                InputTransparent="True"
                Background="{StaticResource HeaderWash}" />

            <!-- ===== Header ===== -->
            <VerticalStackLayout x:Name="HeaderBlock" Grid.Row="0" Padding="20,10,20,8" Spacing="12">
                <Label Text="Search" Style="{StaticResource DisplayText}" />

                <Border Style="{StaticResource SearchPillBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label
                            Grid.Column="0"
                            Text="&#xe8b6;"
                            Style="{StaticResource IconGlyph}"
                            FontSize="20"
                            TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}"
                            VerticalOptions="Center"
                            InputTransparent="True" />

                        <Entry
                            x:Name="QueryEntry"
                            Grid.Column="1"
                            Text="{Binding SearchQuery, Mode=TwoWay}"
                            Placeholder="Songs, albums, artists, lists"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}"
                            ReturnType="Search"
                            ReturnCommand="{Binding SearchCommand}"
                            FontSize="14"
                            BackgroundColor="Transparent"
                            ClearButtonVisibility="Never"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="2"
                            Text="&#xe5cd;"
                            Style="{StaticResource IconButton}"
                            FontSize="18"
                            WidthRequest="28"
                            HeightRequest="28"
                            MinimumWidthRequest="28"
                            MinimumHeightRequest="28"
                            CornerRadius="14"
                            TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
                            IsVisible="{Binding SearchQuery, Converter={StaticResource StringNotEmptyConverter}}"
                            Clicked="OnClearClicked" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ===== Results ===== -->
            <ScrollView x:Name="ResultsScroll" Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="ResultsContent" Padding="20,4,20,20" Spacing="24">

                    <!-- Idle hint -->
                    <VerticalStackLayout IsVisible="{Binding ShowEmptyHint}" Padding="0,56" Spacing="10">
                        <Border Style="{StaticResource IconTile}" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center">
                            <Label
                                Text="&#xe8b6;"
                                FontFamily="MaterialIcons"
                                FontSize="26"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                        <Label Text="Find anything" Style="{StaticResource SectionTitleText}" HorizontalTextAlignment="Center" Margin="0,4,0,0" />
                        <Label
                            Text="Type at least two characters to search tracks, albums, artists and playlists."
                            Style="{StaticResource CaptionText}"
                            LineHeight="1.35"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- No results -->
                    <VerticalStackLayout IsVisible="{Binding ShowNoResults}" Padding="0,56" Spacing="8">
                        <Label Text="No matches" Style="{StaticResource SectionTitleText}" HorizontalTextAlignment="Center" />
                        <Label Text="Try a different title, artist or album name." Style="{StaticResource CaptionText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Tracks -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding TrackResults.Count, Converter={StaticResource IntToBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                            <Label Text="TRACKS" Style="{StaticResource SectionLabelText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding TrackResults.Count}" Style="{StaticResource SectionLabelText}" TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TrackResults}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Music">
                                    <controls:TrackItem Track="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Albums -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding AlbumResults.Count, Converter={StaticResource IntToBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="ALBUMS" Style="{StaticResource SectionLabelText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding AlbumResults.Count}" Style="{StaticResource SectionLabelText}" TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />
                        </Grid>
                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" BindableLayout.ItemsSource="{Binding AlbumResults}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Grid WidthRequest="132" Margin="0,0,14,18">
                                        <controls:AlbumItem Album="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Artists -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ArtistResults.Count, Converter={StaticResource IntToBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                            <Label Text="ARTISTS" Style="{StaticResource SectionLabelText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ArtistResults.Count}" Style="{StaticResource SectionLabelText}" TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ArtistResults}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Artist">
                                    <controls:ArtistItem Artist="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Playlists -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding PlaylistResults.Count, Converter={StaticResource IntToBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                            <Label Text="PLAYLISTS" Style="{StaticResource SectionLabelText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding PlaylistResults.Count}" Style="{StaticResource SectionLabelText}" TextColor="{AppThemeBinding Light={StaticResource FaintOnLight}, Dark={StaticResource FaintOnDark}}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlaylistResults}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Playlist">
                                    <controls:PlaylistItem Playlist="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Docked mini player -->
        <controls:MiniPlayer Grid.Row="1" />
    </Grid>
</ContentPage>
