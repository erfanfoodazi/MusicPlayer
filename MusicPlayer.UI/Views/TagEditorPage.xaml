<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MusicPlayer.UI.Views.TagEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MusicPlayer.UI.ViewModels"
    xmlns:converters="clr-namespace:MusicPlayer.UI.Converters"
    x:DataType="viewmodels:TagEditorViewModel"
    Title="Edit tags"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Soft wash behind the editor header. -->
        <BoxView
            Grid.Row="0"
            Grid.RowSpan="2"
            HeightRequest="210"
            VerticalOptions="Start"
            InputTransparent="True"
            Background="{DynamicResource HeaderWash}" />

        <!-- ===== Top bar ===== -->
        <Grid x:Name="TopBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,8,12,6" ColumnSpacing="8">
            <Button
                Grid.Column="0"
                Text="&#xe5c4;"
                Style="{StaticResource IconButton}"
                FontSize="23"
                Clicked="OnCancelClicked"
                SemanticProperties.Description="Cancel tag editing" />

            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label
                    Text="EDIT TAGS"
                    Style="{StaticResource OverlineText}"
                    CharacterSpacing="2.2"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="{Binding DetailsText}"
                    Style="{StaticResource MetaText}"
                    FontSize="10"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding DetailsText, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Text="Save"
                FontFamily="InterSemiBold"
                FontSize="13"
                HeightRequest="38"
                MinimumHeightRequest="38"
                Padding="22,0"
                CornerRadius="19"
                Background="{DynamicResource AccentGradientHorizontal}"
                TextColor="White"
                IsEnabled="{Binding CanSave}"
                Command="{Binding SaveCommand}" />
        </Grid>

        <ScrollView x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,4,18,28" Spacing="16">

                <!-- ===== Cover ===== -->
                <Border x:Name="CoverSection" Style="{StaticResource CardBorder}" Padding="16,16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border
                            Grid.Column="0"
                            WidthRequest="96"
                            HeightRequest="96"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#12000000, Dark=#22FFFFFF}"
                            StrokeShape="RoundRectangle 16"
                            Background="{StaticResource ArtworkPlaceholderGradient}">
                            <Grid>
                                <Label
                                    Text="&#xe405;"
                                    FontFamily="MaterialIcons"
                                    FontSize="30"
                                    TextColor="{DynamicResource AccentColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasCoverPreview, Converter={StaticResource InvertedBoolConverter}}" />
                                <Image
                                    Source="{Binding CoverPreview}"
                                    IsVisible="{Binding HasCoverPreview}"
                                    Aspect="AspectFill"
                                    WidthRequest="96"
                                    HeightRequest="96" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label
                                Text="COVER ART"
                                Style="{StaticResource SectionLabelText}"
                                Margin="0,0,0,2" />
                            <Label
                                Text="Square images look best. JPEG or PNG, up to 12 MB."
                                Style="{StaticResource CaptionText}"
                                FontSize="11"
                                LineHeight="1.3" />

                            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                <Button
                                    Text="Change"
                                    FontFamily="InterSemiBold"
                                    FontSize="12"
                                    HeightRequest="34"
                                    MinimumHeightRequest="34"
                                    Padding="16,0"
                                    CornerRadius="17"
                                    BackgroundColor="{DynamicResource AccentSoftColor}"
                                    TextColor="{DynamicResource AccentColor}"
                                    Command="{Binding PickCoverCommand}" />
                                <Button
                                    Text="Remove"
                                    FontFamily="InterSemiBold"
                                    FontSize="12"
                                    HeightRequest="34"
                                    MinimumHeightRequest="34"
                                    Padding="14,0"
                                    CornerRadius="17"
                                    BackgroundColor="Transparent"
                                    BorderWidth="1"
                                    BorderColor="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}"
                                    Command="{Binding RemoveCoverCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ===== Track details ===== -->
                <Border x:Name="TrackSection" Style="{StaticResource CardBorder}" Padding="16,16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="TRACK DETAILS" Style="{StaticResource SectionLabelText}" Margin="2,0,0,2" />

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Title" Style="{StaticResource CaptionText}" FontSize="11" Margin="2,0,0,0" />
                            <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" MinimumHeightRequest="50">
                                <Entry
                                    Text="{Binding TitleText, Mode=TwoWay}"
                                    FontSize="14"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    ClearButtonVisibility="WhileEditing"
                                    Placeholder="Track title" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Artist" Style="{StaticResource CaptionText}" FontSize="11" Margin="2,0,0,0" />
                            <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" MinimumHeightRequest="50">
                                <Entry
                                    Text="{Binding ArtistText, Mode=TwoWay}"
                                    FontSize="14"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    Placeholder="Separate several artists with ;" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Album" Style="{StaticResource CaptionText}" FontSize="11" Margin="2,0,0,0" />
                            <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" MinimumHeightRequest="50">
                                <Entry
                                    Text="{Binding AlbumText, Mode=TwoWay}"
                                    FontSize="14"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    Placeholder="Album title" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Album artist" Style="{StaticResource CaptionText}" FontSize="11" Margin="2,0,0,0" />
                            <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" MinimumHeightRequest="50">
                                <Entry
                                    Text="{Binding AlbumArtistText, Mode=TwoWay}"
                                    FontSize="14"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    Placeholder="Usually the album's main artist" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Numbering ===== -->
                <Border x:Name="NumberingSection" Style="{StaticResource CardBorder}" Padding="16,16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="NUMBERING" Style="{StaticResource SectionLabelText}" Margin="2,0,0,2" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Year" Style="{StaticResource CaptionText}" FontSize="11" Margin="2,0,0,0" />
                                <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" MinimumHeightRequest="50" Padding="12,0">
                                    <Entry
                                        Text="{Binding YearText, Mode=TwoWay}"
                                        Keyboard="Numeric"
                                        FontSize="14"
                                        VerticalTextAlignment="Center"
                                        VerticalOptions="Center"
                                        MaxLength="4" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Track" Style="{StaticResource CaptionText}" FontSize="11" Margin="2,0,0,0" />
                                <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" MinimumHeightRequest="50" Padding="12,0">
                                    <Entry
                                        Text="{Binding TrackNumberText, Mode=TwoWay}"
                                        Keyboard="Numeric"
                                        FontSize="14"
                                        VerticalTextAlignment="Center"
                                        VerticalOptions="Center"
                                        MaxLength="3" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="5">
                                <Label Text="Disc" Style="{StaticResource CaptionText}" FontSize="11" Margin="2,0,0,0" />
                                <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" MinimumHeightRequest="50" Padding="12,0">
                                    <Entry
                                        Text="{Binding DiscNumberText, Mode=TwoWay}"
                                        Keyboard="Numeric"
                                        FontSize="14"
                                        VerticalTextAlignment="Center"
                                        VerticalOptions="Center"
                                        MaxLength="3" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Genres ===== -->
                <Border x:Name="GenresSection" Style="{StaticResource CardBorder}" Padding="16,16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="GENRES" Style="{StaticResource SectionLabelText}" Margin="2,0,0,2" />
                        <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" MinimumHeightRequest="50">
                            <Entry
                                Text="{Binding GenresText, Mode=TwoWay}"
                                FontSize="14"
                                VerticalTextAlignment="Center"
                                VerticalOptions="Center"
                                Placeholder="Pop, Rock — separate with commas" />
                        </Border>
                        <Label
                            Text="Commas and semicolons both work. Duplicates are removed when saving."
                            Style="{StaticResource MetaText}"
                            FontSize="10.5"
                            Margin="2,0,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Unsaved-changes hint + status -->
                <Border
                    IsVisible="{Binding HasChanges}"
                    BackgroundColor="{DynamicResource AccentSoftColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="14,11">
                    <HorizontalStackLayout Spacing="8">
                        <Label
                            Text="&#xe3c9;"
                            FontFamily="MaterialIcons"
                            FontSize="16"
                            VerticalOptions="Center"
                            TextColor="{DynamicResource AccentColor}" />
                        <Label
                            Text="Unsaved changes — tap Save to write them into the file."
                            FontFamily="InterMedium"
                            FontSize="12"
                            VerticalOptions="Center"
                            LineHeight="1.3"
                            TextColor="{DynamicResource AccentColor}" />
                    </HorizontalStackLayout>
                </Border>

                <Label
                    x:Name="StatusLabel"
                    Text="{Binding StatusMessage}"
                    IsVisible="{Binding HasStatus}"
                    FontFamily="Inter"
                    FontSize="12"
                    LineHeight="1.35"
                    TextColor="{AppThemeBinding Light={StaticResource MutedOnLight}, Dark={StaticResource MutedOnDark}}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky save bar: the primary action is always within thumb reach on a phone. -->
        <Border
            Grid.Row="2"
            Padding="18,10,18,14"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-6" Radius="18" Opacity="0.22" />
            </Border.Shadow>
            <Button
                Text="Save changes"
                Style="{StaticResource PrimaryPillButton}"
                HeightRequest="48"
                CornerRadius="24"
                IsEnabled="{Binding CanSave}"
                Command="{Binding SaveCommand}" />
        </Border>

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Color="{DynamicResource Primary}" />
    </Grid>
</ContentPage>
